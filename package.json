{
	"name": "webhook",
	"workspaces": [
		"packages/*",
		"packages/plugins/*"
	],
	"catalog": {
		"@types/bun": "latest",
		"typescript": "^5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/bun": "^1.3.11",
		"typescript": "^5:"
	},
	"scripts": {
		"dev": "bun run --filter '@webhook/server' dev",
		"build": "bun run --filter '*' build",
		"build:pkg": "bash -c 'bun run --filter @webhook/$0 build'",
		"fmt": "bun run --filter '*' fmt",
		"lint": "bun run --filter '*' lint",
		"typecheck": "bun run --filter '*' typecheck",
		"check": "bun run --filter '*' check"
	}
}
